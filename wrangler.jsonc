{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "widget-clap",
  "main": "server/preview.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "preview_urls": true,
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
}
