# ACCESS_AUDIENCE=your-application-aud
# OWNER_EMAIL=owner@example.com
# SPAM_SECRET=generate-a-random-32-byte-secret
# TURNSTILE_SECRET_KEY=...
# TURNSTILE_SITE_KEY=...
# TIP_LINKS_ENABLED=false
