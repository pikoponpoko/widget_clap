{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creator-support-widget",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "routes": [{ "pattern": "hakushu.kazukisekiguchi.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist-owner",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "support",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "creator-support-images" },
    { "binding": "BACKUPS", "bucket_name": "creator-support-private-backups" },
  ],
  "triggers": { "crons": ["0 18 * * *"] },
  "vars": { "ENVIRONMENT": "production", "TIP_LINKS_ENABLED": "false" },
}
